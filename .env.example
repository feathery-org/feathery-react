# Storybook's "backend" theme fetches a real form from a Feathery backend and
# styles the stories with its resolved element styles. Copy this file to
# .env.local (gitignored) and restart `yarn storybook` after editing.

# Backend API root, with trailing slash. The local Django dev server by default.
STORYBOOK_FEATHERY_API_URL=http://localhost:8006/api/

# The SDK key of an environment in the org that owns the form. For a local
# backend, every Environment row already has one:
#   ./manage.py shell -c "from apps.environment.models import Environment; print(Environment.objects.filter(organization__name='Test Org', primary=True).first().sdk_key)"
STORYBOOK_FEATHERY_SDK_KEY=

# The form to style from: one of its public slugs in that environment
# (PanelEnvironmentSlug.slug), or its key (the form name).
STORYBOOK_FEATHERY_FORM_KEY=
