# Storybook's theme menu lists the themes of a Feathery backend's org through
# the public theme API (/api/theme/), and styles the stories with the chosen
# one's resolved element styles. Copy this file to .env.local (gitignored) and restart
# `yarn storybook` after editing.

# Backend API root, with trailing slash. The local Django dev server by default.
STORYBOOK_FEATHERY_API_URL=http://localhost:8006/api/

# The API key of an environment in the org that owns the theme (Settings ->
# API Keys in the dashboard). The org must be on a paid plan. For a local
# backend, every Environment row already has one:
#   ./manage.py shell -c "from apps.environment.models import Environment; print(Environment.objects.filter(organization__name='Test Org', primary=True).first().api_key)"
STORYBOOK_FEATHERY_API_KEY=

