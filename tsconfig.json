{
  "compilerOptions": {
    "sourceMap": true,
    "declaration": true,
    "outDir": "dist",
    "declarationMap": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "target": "es5",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false, // This is true in feathery-frontend, but needs to be false here
    "downlevelIteration": true // This enables to iterate the string set (Form/utils)
  },
  // Test-only helpers import devDependencies and must stay out of dist.
  "exclude": [
    "node_modules",
    "src/**/tests/**",
    "src/**/*.spec.ts",
    "src/**/*.spec.js"
  ],
  "include": ["./src/**/*"]
}
